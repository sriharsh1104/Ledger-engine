# Get your free Project ID at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_project_id_here

# Prefer relative path so LAN devices work:
# open http://YOUR_LAN_IP:5173 — Vite proxies /api and /ws to the gateway.
VITE_API_BASE_URL=/api/v1

# Optional: direct gateway WS (only if not using Vite /ws proxy)
# VITE_WS_URL=ws://10.10.0.52:8088/ws

# Use local mock auth/data when Go backend is not running
VITE_USE_MOCK_API=false

# Optional override — defaults to `${VITE_API_BASE_URL}/chatbot`
# VITE_CHATBOT_API_URL=/api/v1/chatbot
