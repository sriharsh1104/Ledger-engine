# Get your free Project ID at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_project_id_here

# Go API base URL
VITE_API_BASE_URL=http://localhost:8088/api/v1

# Optional override for gateway WebSocket (default derived from API base → ws://HOST:8088/ws)
# VITE_WS_URL=ws://127.0.0.1:8088/ws

# Use local mock auth/data when Go backend is not running
VITE_USE_MOCK_API=false

# AI CLI Chatbot (https://ai-cli-chatbot-production.up.railway.app/docs)
VITE_CHATBOT_API_URL=https://ai-cli-chatbot-production.up.railway.app
VITE_CHATBOT_API_KEY=
